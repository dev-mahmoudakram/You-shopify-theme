<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="{{ settings.color_background }}">
    <link rel="canonical" href="{{ canonical_url }}">

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- else -%}
      <link rel="icon" type="image/jpeg" href="{{ 'logo-badge.jpg' | asset_url }}">
    {%- endif -%}

    <title>
      {{ page_title }}
      {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
      {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>

    {% if page_description %}
      <meta name="description" content="{{ page_description | escape }}">
    {% endif %}

    {% render 'meta-tags' %}

    <link rel="preload" href="{{ 'inter-var-latin.woff2' | asset_url }}" as="font" type="font/woff2" crossorigin>
    <link rel="preload" href="{{ 'plex-arabic-var.woff2' | asset_url }}" as="font" type="font/woff2" crossorigin>

    <style>
      :root {
        --paper: {{ settings.color_background | default: '#0A0A0A' }};
        --ink: {{ settings.color_text | default: '#F2F2EF' }};
        --mute: {{ settings.color_mute | default: '#8F8F89' }};
        --line: {{ settings.color_line | default: '#262624' }};
        --raised: {{ settings.color_raised | default: '#161614' }};
        --sage: {{ settings.color_accent | default: '#91A89A' }};
        --sage-hover: {{ settings.color_accent_hover | default: '#AFC5B8' }};
        --display-scale: {{ settings.display_scale | default: 100 | divided_by: 100.0 }};
      }
      .display { font-size: calc(1em * var(--display-scale)); }

      @font-face {
        font-family: 'Inter';
        font-style: normal;
        font-weight: 100 900;
        font-display: swap;
        src: url('{{ "inter-var-latin.woff2" | asset_url }}') format('woff2');
      }
      @font-face {
        font-family: 'IBM Plex Sans Arabic';
        font-style: normal;
        font-weight: 100 700;
        font-display: swap;
        src: url('{{ "plex-arabic-var.woff2" | asset_url }}') format('woff2');
      }
    </style>

    {{ 'theme.css' | asset_url | stylesheet_tag }}

    <script>
      document.documentElement.className = document.documentElement.className.replace('no-js', 'js');
      window.YOU = {
        moneyFormat: {{ shop.money_format | json }},
        freeShippingThreshold: {{ settings.free_shipping_threshold | default: 150 | times: 100 }},
        cartDrawer: {{ settings.cart_drawer_enabled | default: true | json }},
        music: {
          enabled: {{ settings.music_enabled | default: false | json }},
          track: '{{ settings.music_track | default: "you-theme.m4a" | asset_url }}',
          volume: {{ settings.music_volume | default: 55 | divided_by: 100.0 | json }}
        }
      };
    </script>
    <script src="{{ 'theme.js' | asset_url }}" defer></script>

    {{ content_for_header }}
  </head>

  <body class="template-{{ template.name | handle }}">
    <a class="skip-link" href="#MainContent">Skip to content</a>

    {% sections 'header-group' %}

    <main id="MainContent" class="content-for-layout" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    {% render 'cart-drawer' %}
    <div class="overlay-veil" data-overlay-veil hidden></div>
  </body>
</html>
