{%- comment -%} YOU® — Footer {%- endcomment -%}
<footer class="footer" role="contentinfo">
  <div class="container">
    <div class="footer__grid">
      <div class="footer__brand">
        {%- if settings.logo != blank -%}
          <img src="{{ settings.logo | image_url: width: 440 }}" alt="{{ shop.name }}" loading="lazy">
        {%- else -%}
          <img src="{{ 'logo-sage.png' | asset_url }}" alt="{{ shop.name }}" loading="lazy">
        {%- endif -%}
        <div class="footer__note">{{ settings.footer_note }}</div>
      </div>

      {%- for block in section.blocks -%}
        <div {{ block.shopify_attributes }}>
          <h3 class="footer__heading">{{ block.settings.heading | escape }}</h3>
          <ul class="footer__links">
            {%- for link in block.settings.menu.links -%}
              <li><a href="{{ link.url }}">{{ link.title }}</a></li>
            {%- endfor -%}
          </ul>
        </div>
      {%- endfor -%}

      <div>
        <h3 class="footer__heading">Follow</h3>
        <div class="footer__socials">
          {%- if settings.social_instagram_link != blank -%}<a href="{{ settings.social_instagram_link }}" target="_blank" rel="noopener">Instagram</a>{%- endif -%}
          {%- if settings.social_tiktok_link != blank -%}<a href="{{ settings.social_tiktok_link }}" target="_blank" rel="noopener">TikTok</a>{%- endif -%}
          {%- if settings.social_x_link != blank -%}<a href="{{ settings.social_x_link }}" target="_blank" rel="noopener">X</a>{%- endif -%}
          {%- if settings.social_facebook_link != blank -%}<a href="{{ settings.social_facebook_link }}" target="_blank" rel="noopener">Facebook</a>{%- endif -%}
        </div>
      </div>
    </div>

    <div class="footer__bottom">
      <p class="footer__copyright">© {{ 'now' | date: '%Y' }} {{ settings.footer_copyright | escape }}</p>
      <p class="footer__wordmark">Oversized. Made Different.</p>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "blocks": [
    {
      "type": "menu",
      "name": "Menu column",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Shop" },
        { "type": "link_list", "id": "menu", "label": "Menu", "default": "footer" }
      ]
    }
  ],
  "max_blocks": 2,
  "default": {
    "blocks": [{ "type": "menu" }]
  }
}
{% endschema %}
