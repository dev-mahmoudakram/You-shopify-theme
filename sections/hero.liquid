{%- comment -%} YOU® — Hero: near full-screen editorial image {%- endcomment -%}
<section class="hero hero--lake">
  {%- if section.settings.image_mobile -%}
    <img
      class="hero__img hero__img--mobile"
      src="{{ section.settings.image_mobile | image_url: width: 1000 }}"
      srcset="{{ section.settings.image_mobile | image_url: width: 600 }} 600w, {{ section.settings.image_mobile | image_url: width: 1000 }} 1000w, {{ section.settings.image_mobile | image_url: width: 1400 }} 1400w"
      alt="{{ section.settings.image_mobile.alt | escape }}"
      width="1000" height="{{ section.settings.image_mobile.height }}" fetchpriority="high">
  {%- endif -%}

  {%- if section.settings.image -%}
    <img
      class="hero__img hero__img--desktop"
      src="{{ section.settings.image | image_url: width: 2000 }}"
      srcset="{{ section.settings.image | image_url: width: 1200 }} 1200w, {{ section.settings.image | image_url: width: 1600 }} 1600w, {{ section.settings.image | image_url: width: 2000 }} 2000w"
      alt="{{ section.settings.image.alt | escape }}"
      width="2000" height="{{ section.settings.image.height }}" fetchpriority="high">
  {%- endif -%}

  {%- assign has_hero_media = false -%}
  {%- if section.settings.image != blank or section.settings.image_mobile != blank -%}{%- assign has_hero_media = true -%}{%- endif -%}
  <div class="hero__scrim"{% unless has_hero_media %} hidden{% endunless %}></div>

  <div class="hero__content">
    <div class="container hero__inner">
      <div class="hero__copy">
        {%- if section.settings.eyebrow != blank -%}<p class="eyebrow hero__eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
        {%- if section.settings.heading_line_1 != blank or section.settings.heading_line_2 != blank -%}
          <h1 class="display hero__title">
            {{ section.settings.heading_line_1 | escape }}{% if section.settings.heading_line_1 != blank and section.settings.heading_line_2 != blank %}<br>{% endif %}{{ section.settings.heading_line_2 | escape }}
          </h1>
        {%- endif -%}
        {%- if section.settings.description != blank -%}<p class="hero__description">{{ section.settings.description | escape | newline_to_br }}</p>{%- endif -%}
        {%- if section.settings.values_intro != blank or section.settings.values_emphasis != blank -%}
          <p class="hero__values">{{ section.settings.values_intro | escape }}{% if section.settings.values_intro != blank and section.settings.values_emphasis != blank %} {% endif %}{% if section.settings.values_emphasis != blank %}<em>{{ section.settings.values_emphasis | escape }}</em>{% endif %}</p>
        {%- endif -%}
        {%- if section.settings.closing_line != blank -%}<p class="hero__closing">{{ section.settings.closing_line | escape }}</p>{%- endif -%}
        {%- if section.settings.signature != blank -%}<p class="hero__signature"><em>{{ section.settings.signature | escape }}</em></p>{%- endif -%}
        {%- if section.settings.cta_label != blank or section.settings.link_label != blank -%}<div class="hero__cta">
          {%- if section.settings.cta_label != blank -%}<a class="btn btn--light" href="{{ section.settings.cta_link | default: routes.all_products_collection_url }}">{{ section.settings.cta_label | escape }}</a>{%- endif -%}
          {%- if section.settings.link_label != blank -%}
            <a class="hero__link link-underline" href="{{ section.settings.link_url | default: routes.root_url }}">{{ section.settings.link_label | escape }}</a>
          {%- endif -%}
        </div>{%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    { "type": "textarea", "id": "description", "label": "Origin and design lines", "default": "Made in Egypt.\nBuilt with high-quality materials.\nDesigned for those who don’t follow the usual." },
    { "type": "text", "id": "values_intro", "label": "Values sentence", "default": "At YOU, we create pieces that bring together" },
    { "type": "text", "id": "values_emphasis", "label": "Values emphasis", "default": "quality, design, and attitude." },
    { "type": "text", "id": "closing_line", "label": "Closing line", "default": "Every piece is made to feel like you." },
    { "type": "text", "id": "signature", "label": "Signature", "default": "YOU,JUST FOR YOU" },
    { "type": "image_picker", "id": "image", "label": "Image — desktop (landscape)" },
    { "type": "image_picker", "id": "image_mobile", "label": "Image — mobile (portrait)" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading_line_1", "label": "Heading — line 1", "default": "YOU isn’t just what you wear." },
    { "type": "text", "id": "heading_line_2", "label": "Heading — line 2", "default": "It’s how you express who you are." },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "Shop Collection" },
    { "type": "url", "id": "cta_link", "label": "Button link" },
    { "type": "text", "id": "link_label", "label": "Secondary link label", "default": "View Lookbook" },
    { "type": "url", "id": "link_url", "label": "Secondary link" }
  ],
  "presets": [{ "name": "Hero" }]
}
{% endschema %}
