{%- comment -%} YOU® — Instagram gallery {%- endcomment -%}
<section class="instagram">
  <div class="container">
    <div class="section-head section-head--center reveal" style="margin-bottom:32px;">
      <p class="eyebrow eyebrow--sage">{{ section.settings.eyebrow | escape }}</p>
      <h2 class="display featured__title">{{ section.settings.heading | escape }}</h2>
    </div>
    <div class="insta__grid">
      {%- for block in section.blocks -%}
        {%- assign mod = forloop.index0 | modulo: 6 -%}
        <a class="insta__tile reveal" href="{{ section.settings.link | default: settings.social_instagram_link | default: '#' }}" target="_blank" rel="noopener" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            <img src="{{ block.settings.image | image_url: width: 700 }}" alt="" loading="lazy" width="700" height="700">
          {%- else -%}
            {%- assign demo = 'look1,look2,look4,style1,style2,style3' | split: ',' -%}
            <img src="{{ demo[mod] | append: '.jpg' | asset_url }}" alt="" loading="lazy" width="700" height="700">
          {%- endif -%}
          <div class="insta__veil"><span class="insta__handle">{{ section.settings.handle | escape }}</span></div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Instagram gallery",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Community" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "@YOU.WEAR" },
    { "type": "text", "id": "handle", "label": "Handle shown on hover", "default": "@you.wear" },
    { "type": "url", "id": "link", "label": "Profile link" }
  ],
  "blocks": [
    { "type": "tile", "name": "Tile", "settings": [{ "type": "image_picker", "id": "image", "label": "Image (square)" }] }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Instagram gallery",
      "blocks": [
        { "type": "tile" }, { "type": "tile" }, { "type": "tile" },
        { "type": "tile" }, { "type": "tile" }, { "type": "tile" }
      ]
    }
  ]
}
{% endschema %}
