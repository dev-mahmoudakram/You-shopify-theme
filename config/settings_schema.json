[
  {
    "name": "theme_info",
    "theme_name": "YOU® — Oversized. Made Different.",
    "theme_version": "1.0.0",
    "theme_author": "YOU®",
    "theme_documentation_url": "https://shopify.dev/docs/themes",
    "theme_support_url": "https://shopify.dev/docs/themes"
  },
  {
    "name": "Colors",
    "settings": [
      {
        "type": "color",
        "id": "color_background",
        "label": "Page background",
        "default": "#0A0A0A"
      },
      {
        "type": "color",
        "id": "color_text",
        "label": "Text",
        "default": "#F2F2EF"
      },
      {
        "type": "color",
        "id": "color_mute",
        "label": "Muted text",
        "default": "#8F8F89"
      },
      {
        "type": "color",
        "id": "color_line",
        "label": "Borders and lines",
        "default": "#262624"
      },
      {
        "type": "color",
        "id": "color_raised",
        "label": "Raised surfaces",
        "default": "#161614"
      },
      {
        "type": "color",
        "id": "color_accent",
        "label": "Accent (sage)",
        "default": "#91A89A"
      },
      {
        "type": "color",
        "id": "color_accent_hover",
        "label": "Accent hover",
        "default": "#AFC5B8"
      }
    ]
  },
  {
    "name": "Typography",
    "settings": [
      {
        "type": "range",
        "id": "display_scale",
        "label": "Display headline scale",
        "min": 80,
        "max": 120,
        "step": 5,
        "unit": "%",
        "default": 100
      }
    ]
  },
  {
    "name": "Header",
    "settings": [
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Logo image (transparent PNG works best on the black header)"
      },
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon (32×32)"
      },
      {
        "type": "range",
        "id": "logo_width",
        "label": "Logo width",
        "min": 80,
        "max": 220,
        "step": 10,
        "unit": "px",
        "default": 130
      }
    ]
  },
  {
    "name": "Cart",
    "settings": [
      {
        "type": "checkbox",
        "id": "cart_drawer_enabled",
        "label": "Enable cart drawer",
        "default": true
      },
      {
        "type": "range",
        "id": "free_shipping_threshold",
        "label": "Free shipping threshold",
        "min": 0,
        "max": 500,
        "step": 10,
        "unit": "$",
        "default": 150
      }
    ]
  },
  {
    "name": "Background music",
    "settings": [
      {
        "type": "checkbox",
        "id": "music_enabled",
        "label": "Enable background music",
        "info": "Plays at the visitor's first interaction (browsers block sound before that). A sound toggle appears in the header.",
        "default": true
      },
      {
        "type": "text",
        "id": "music_track",
        "label": "Audio file in theme assets",
        "info": "File name of an audio file uploaded to the theme assets, e.g. you-theme.m4a",
        "default": "you-theme.m4a"
      },
      {
        "type": "range",
        "id": "music_volume",
        "label": "Music volume",
        "min": 10,
        "max": 100,
        "step": 5,
        "unit": "%",
        "default": 55
      }
    ]
  },
  {
    "name": "Social media",
    "settings": [
      { "type": "text", "id": "social_instagram_link", "label": "Instagram", "default": "https://instagram.com" },
      { "type": "text", "id": "social_tiktok_link", "label": "TikTok", "default": "" },
      { "type": "text", "id": "social_x_link", "label": "X (Twitter)", "default": "" },
      { "type": "text", "id": "social_facebook_link", "label": "Facebook", "default": "" }
    ]
  },
  {
    "name": "Footer",
    "settings": [
      {
        "type": "richtext",
        "id": "footer_note",
        "label": "Footer note",
        "default": "<p>Oversized silhouettes, distinctive details. Designed to be different.</p>"
      },
      {
        "type": "text",
        "id": "footer_copyright",
        "label": "Copyright line",
        "default": "YOU® — All rights reserved"
      }
    ]
  }
]
